# ==============================================================================
# NetMentor Server-Side Environment Configuration
# ==============================================================================
# IMPORTANT: These variables are read exclusively by Vercel Serverless Functions.
# Never prefix them with VITE_ and never commit real values to version control.
# ==============================================================================

# Administrator username (configured default: jenilmoradiya50)
ADMIN_USERNAME=jenilmoradiya50

# Administrator private password (set your private password here)
ADMIN_PASSPHRASE=replace_with_your_strong_private_password_here

# Cryptographically secure random secret used to sign session cookies (minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long

# Node environment mode: 'development' allows HTTP cookies on localhost; 'production' forces Secure cookies over HTTPS
NODE_ENV=development

# Neon PostgreSQL Database connection string (for Phase 4 persistent storage)
DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/netmentor?sslmode=require

# Google Gemini API Key (for future AI phase)
# GEMINI_API_KEY=your_gemini_api_key_here
