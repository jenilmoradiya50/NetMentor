# Database connection string (from Neon console)
DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/netmentor?sslmode=require

# Secure random secret for signing session tokens (min 32 chars)
SESSION_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long

# Master passphrase for single-user authentication
ADMIN_ACCESS_KEY=your_secure_personal_passphrase

# Gemini API Key (Phase 4)
# GEMINI_API_KEY=your_gemini_api_key_here

# Environment
NODE_ENV=development
